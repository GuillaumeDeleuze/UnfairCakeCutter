<?xml version="1.0" encoding="utf-8"?>
<!-- A cream plate with an ink rim and a hard shadow; the cake on it, one slice sliding off. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Drawn at plate size 58, then scaled so the pink background shows around it. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.8"
        android:scaleY="0.8">
    <!-- Hard shadow, then the plate. -->
    <path android:fillColor="#FF3A0A2A" android:pathData="M57,57m-29,0a29,29 0 1,0 58,0a29,29 0 1,0 -58,0" />
    <path
        android:fillColor="#FFFFF1F7"
        android:strokeColor="#FF3A0A2A"
        android:strokeWidth="3"
        android:pathData="M54,54m-29,0a29,29 0 1,0 58,0a29,29 0 1,0 -58,0" />
    <!-- The cake, missing its best slice. -->
    <path
        android:fillColor="#FFFF8CC0"
        android:strokeColor="#FF3A0A2A"
        android:strokeWidth="2.2"
        android:strokeLineJoin="round"
        android:pathData="M52,56 L52,36 A20,20 0 1,0 72,56 Z" />
    <!-- The slice somebody took. -->
    <path
        android:fillColor="#FFFFD23F"
        android:strokeColor="#FF3A0A2A"
        android:strokeWidth="2.2"
        android:strokeLineJoin="round"
        android:pathData="M56,52 L56,32 A20,20 0 0,1 76,52 Z" />
    <!-- Cut lines. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:pathData="M52,56 L34.5,66 M52,56 L42,73.5" />
    </group>
</vector>
